{
  "bytecode_file": "output.bytecode",
  "logging": {
    "level": "info",
    "output": "console",
    "time_format": "unixnano"
  },
  "redis": {
    "address": "localhost:6379",
    "password": "",
    "database": 0,
    "channels": [
      "weather",
      "system",
      "network",
      "energy",
      "water",
      "pressure",
      "humidity",
      "temperature",
      "flow_rate"
    ]
  },
  "engine": {
    "priority_threshold": 1,
    "scripts_enabled": false,
    "max_actions_per_evaluation": 32,
    "max_event_hops": 16
  },
  "observability": {
    "enabled": false,
    "address": "127.0.0.1:8080"
  }
}
