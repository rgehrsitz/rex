{
  "bytecode_file": "output.bytecode",
  "logging": {
    "level": "info",
    "output": "console",
    "time_format": "unixnano",
    "trace_conditions": true
  },
  "redis": {
    "address": "localhost:6379",
    "password": "",
    "database": 0,
    "channels": [
      "weather",
      "system",
      "network",
      "energy",
      "water",
      "pressure",
      "humidity",
      "temperature",
      "flow_rate"
    ]
  },
  "engine": {
    "priority_threshold": 1,
    "scripts_enabled": false,
    "max_actions_per_evaluation": 32,
    "max_event_hops": 16,
    "allow_legacy_v3": false,
    "batch": {
      "event_bytes": 1048576,
      "event_facts": 256,
      "snapshot_bytes": 4194304,
      "actions_per_round": 256,
      "chain_actions": 1024,
      "chain_work": 100000,
      "rounds": 16,
      "staged_bytes": 1048576
    }
  },
  "observability": {
    "enabled": false,
    "address": "127.0.0.1:8080"
  }
}
