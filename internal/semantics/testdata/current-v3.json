  {
    "name": "nested-all-any",
    "contract": "current-v3",
    "ruleset": {
      "rules": [
        {
          "name": "r",
          "priority": 10,
          "conditions": {
            "all": [
              {
                "fact": "a",
                "operator": "GT",
                "value": 0
              },
              {
                "any": [
                  {
                    "fact": "b",
                    "operator": "EQ",
                    "value": true
                  },
                  {
                    "all": [
                      {
                        "fact": "c",
                        "operator": "CONTAINS",
                        "value": "yes"
                      },
                      {
                        "fact": "d",
                        "operator": "NEQ",
                        "value": 0
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "actions": [
            {
              "type": "updateStore",
              "target": "out",
              "value": true
            }
          ]
        }
      ]
    },
    "initial": {
      "b": false,
      "c": "yes indeed",
      "d": 1
    },
    "batches": [
      {
        "a": 1
      }
    ],
    "expected": {
      "facts": {
        "a": 1,
        "b": false,
        "c": "yes indeed",
        "d": 1,
        "out": true
      },
      "local": {
        "a": 1,
        "b": false,
        "c": "yes indeed",
        "d": 1,
        "out": true
      },
      "actions": [
        {
          "key": "out",
          "value": true,
          "outcome": "succeeded",
          "at": "1970-01-01T00:00:00Z"
        }
      ],
      "errors": []
    }
  },
