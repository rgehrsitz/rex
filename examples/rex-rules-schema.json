{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "facts": {
      "description": "Optional closed fact namespace. Presence selects v5 unless a temporal condition selects v6.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 65536,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 255,
        "not": {"pattern": "^__rex_temporal_"}
      },
      "additionalProperties": {
        "$ref": "#/definitions/factDeclaration"
      }
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/ruleWithUniqueName"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "description": "The name of the rule.  Must be unique.",
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "priority": {
                "type": "integer",
                "description": "The priority of the rule.  The lower the number, the higher the priority.  Defaults to 10.",
                "minimum": 0,
                "maximum": 4294967295,
                "default": 10
              },
              "conditions": {
                "type": "object",
                "properties": {
                  "all": {
                    "$ref": "#/definitions/conditionGroup"
                  },
                  "any": {
                    "$ref": "#/definitions/conditionGroup"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "all"
                    ]
                  },
                  {
                    "required": [
                      "any"
                    ]
                  }
                ],
                "additionalProperties": false
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "updateStore"
                      ]
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "not": {"pattern": "^__rex_temporal_"}
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "string",
                          "maxLength": 255,
                          "not": {
                            "pattern": "^\\{[\\s\\S]*\\}$"
                          }
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "target",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "name",
              "conditions",
              "actions"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "rules"
  ],
  "definitions": {
    "factDeclaration": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["number", "string", "boolean"]
        },
        "nullable": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "ruleWithUniqueName": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "conditionGroup": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "not": {"pattern": "^__rex_temporal_"}
              },
              "operator": {
                "type": "string",
                "enum": [
                  "EQ",
                  "NEQ",
                  "LT",
                  "LTE",
                  "GT",
                  "GTE",
                  "CONTAINS",
                  "NOT_CONTAINS"
                ]
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "for": {
                "type": "string",
                "minLength": 1,
                "description": "Processing-time duration for which this predicate must remain true, such as 30s or 5m. Presence selects v6."
              }
            },
            "required": [
              "fact",
              "operator",
              "value"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operator": {
                      "enum": [
                        "LT",
                        "LTE",
                        "GT",
                        "GTE"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operator": {
                      "enum": [
                        "CONTAINS",
                        "NOT_CONTAINS"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "all": {
                "$ref": "#/definitions/conditionGroup"
              },
              "any": {
                "$ref": "#/definitions/conditionGroup"
              }
            },
            "oneOf": [
              {
                "required": [
                  "all"
                ]
              },
              {
                "required": [
                  "any"
                ]
              }
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "title": "REX batch ruleset",
  "description": "Batch v4/v5/v6: scalar conditions, script-free actions, simultaneous snapshots, optional typed fact declarations, and optional v6 processing-time durations. Compiler additionally enforces unique rule names, declaration references, type agreement, duration bounds, and UTF-8 byte limits.",
  "additionalProperties": false
}
