{
  "rules": [
    {
      "name": "east-hot",
      "conditions": {"all": [{"fact": "east.temperature", "operator": "GT", "value": 30}]},
      "actions": [{"type": "updateStore", "target": "east.alert", "value": true}]
    },
    {
      "name": "east-fan",
      "conditions": {"all": [{"fact": "east.alert", "operator": "EQ", "value": true}]},
      "actions": [{"type": "updateStore", "target": "east.fan", "value": true}]
    },
    {
      "name": "west-hot",
      "conditions": {"all": [{"fact": "west.temperature", "operator": "GT", "value": 30}]},
      "actions": [{"type": "updateStore", "target": "west.alert", "value": true}]
    }
  ]
}
