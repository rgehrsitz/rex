{
  "rules": [
    {
      "name": "hot",
      "priority": 1,
      "conditions": {
        "all": [
          {
            "fact": "temperature",
            "operator": "GT",
            "value": 30
          }
        ]
      },
      "actions": [
        {
          "type": "updateStore",
          "target": "alert",
          "value": true
        }
      ]
    }
  ]
}
