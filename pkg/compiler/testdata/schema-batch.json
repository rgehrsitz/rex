  {
    "name": "nested_all_any_and_contains",
    "valid": true,
    "document": {
      "rules": [
        {
          "name": "nested",
          "priority": 2,
          "conditions": {
            "all": [
              {
                "fact": "message",
                "operator": "CONTAINS",
                "value": "ready"
              },
              {
                "any": [
                  {
                    "fact": "region",
                    "operator": "EQ",
                    "value": "east"
                  },
                  {
                    "fact": "region",
                    "operator": "EQ",
                    "value": "west"
                  }
                ]
              }
            ]
          },
          "actions": [
            {
              "type": "updateStore",
              "target": "eligible",
              "value": true
            }
          ]
        }
      ]
    }
  },
